<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 基础浅色渐变 -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#D6E6F5"
                android:centerColor="#ECF2F9"
                android:endColor="#FBF2E4"
                android:type="linear" />
        </shape>
    </item>

    <!-- 左上 蓝色光斑（明显） -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.10"
                android:centerY="0.0"
                android:gradientRadius="520dp"
                android:startColor="#8C4A7FD0"
                android:endColor="#004A7FD0" />
        </shape>
    </item>

    <!-- 右上 金色光斑 -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.95"
                android:centerY="0.08"
                android:gradientRadius="440dp"
                android:startColor="#73E8A23C"
                android:endColor="#00E8A23C" />
        </shape>
    </item>

    <!-- 左下 青色光斑 -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.02"
                android:centerY="0.55"
                android:gradientRadius="480dp"
                android:startColor="#662FB8B0"
                android:endColor="#002FB8B0" />
        </shape>
    </item>

    <!-- 右下 紫色光斑 -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.98"
                android:centerY="0.85"
                android:gradientRadius="420dp"
                android:startColor="#5E8E6FD0"
                android:endColor="#008E6FD0" />
        </shape>
    </item>
</layer-list>
