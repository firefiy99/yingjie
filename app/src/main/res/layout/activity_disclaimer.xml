<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 毛玻璃背景层 -->
    <View
        android:id="@+id/glass_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_backdrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/frosted_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="免责声明"
                android:textColor="#102A43"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/disclaimer_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/disclaimer_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="#334E68"
                    android:textSize="13sp" />
            </ScrollView>

            <Button
                android:id="@+id/btn_agree"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#B0BEC5"
                android:enabled="false"
                android:text="我已阅读并同意，继续使用"
                android:textAllCaps="false"
                android:textColor="#102A43"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_disagree"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#00FFFFFF"
                android:text="拒绝"
                android:textAllCaps="false"
                android:textColor="#627D98" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
